# Compiled Swift helper (rebuilt on demand by bin/ocr)
bin/ocr-vision

# Video production intermediates (large; regenerated by content/youtube/build-video.py)
content/youtube/build/
content/youtube/audio/
content/youtube/*.mp4
content/youtube/*.srt
content/youtube/*.vtt

# Test output
test/out/
test/fixtures/generated/

# Session scratch (previews, reports)
scratch/

# Node (content/youtube/render-slides.mjs is dependency-free, but editors may add these)
node_modules/

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*.local.json
